{
  "name": "optional-diff-demo",
  "lockfileVersion": 3,
  "packages": {
    "": {
      "optionalDependencies": {
        "@native/root": "1.0.0",
        "missing-in-both": "1.0.0"
      }
    },
    "node_modules/@tools/worker": {
      "version": "1.0.0",
      "optionalDependencies": {"@native/engine": "1.0.0"}
