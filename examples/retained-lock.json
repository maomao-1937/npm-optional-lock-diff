    "node_modules/@native/root": {"optional": true},
    "node_modules/app": {"version": "1.0.0"},
    "node_modules/app/node_modules/@tools/worker": {
      "version": "1.0.0",
      "optionalDependencies": {"@native/engine": "1.0.0"}
    },
    "node_modules/app/node_modules/@native/engine": {"version": "1.0.0", "optional": true}
  }
